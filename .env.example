# 应用环境
APP_ENV=development
LOG_LEVEL=INFO

# 业务库（系统库）MySQL —— 存储 users / chat / conversation / chart_data
BIZ_MYSQL_HOST=127.0.0.1
BIZ_MYSQL_PORT=3306
BIZ_MYSQL_DB=nl2sql_platform
BIZ_MYSQL_USER=root
BIZ_MYSQL_PASSWORD=root

# 数据源 MySQL（用户实际查询的目标库）
DATA_MYSQL_HOST=127.0.0.1
DATA_MYSQL_PORT=3306
DATA_MYSQL_DB=power_grid
DATA_MYSQL_USER=root
DATA_MYSQL_PASSWORD=root

# Elasticsearch（检索/元数据存储）
ES_HOST=http://127.0.0.1:9200
ES_USER=
ES_PASSWORD=

# 鉴权
LOGIN_ENABLED=false
JWT_SECRET=please-change-me



# ---- DeepSeek 模型 ----
DEEPSEEK_ENABLED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 可选：deepseek-chat（通用）/ deepseek-reasoner（深度推理）
DEEPSEEK_MODEL=deepseek-chat

# ---- M1 元数据扫描与画像（可选，均有代码默认值）----
# 元数据仓储（SQLite，相对项目根目录；不要切换到业务 MySQL）
METADATA_DATABASE_URL=sqlite:///./metadata.db
# 本地凭证文件：0600 权限明文 JSON，仅限本地开发，生产需接密钥管理服务
CREDENTIAL_STORE_PATH=./.credential_store.json
# 字段画像采样行数上限（1-10000）
PROFILE_SAMPLE_ROWS=500
# 单次扫描最多处理的表数（超出部分记为 skipped）
SCAN_MAX_TABLES=100
# 单表最多计算画像的列数（超出列仅保留结构元数据）
PROFILE_MAX_COLUMNS=64
# 扫描错误明细最多记录条数
SCAN_MAX_RECORDED_ERRORS=50
# 追加固敏感列名关键词（JSON 数组，小写子串匹配；内置规则见 app/security/masking.py）
SENSITIVE_COLUMN_KEYWORDS=[]
# ---- M2 语义分析预算（可选，均有代码默认值）----
# 单次语义分析最多处理的列数（超出记 budget_truncated）
SEMANTICS_MAX_COLUMNS_PER_RUN=40
# 单次分析的模型请求总预算：含传输重试与结构修复的全部 HTTP 尝试次数
SEMANTICS_LLM_MAX_CALLS=2
# 模型输入字符上限（超出则本次仅用规则结果）
SEMANTICS_INPUT_CHAR_LIMIT=24000
# 单次分析的模型调用总期限（秒），独立于单次请求超时
SEMANTICS_LLM_DEADLINE_SECONDS=120
# 样本外发总开关（默认关闭；还需请求体 send_samples=true 同时开启）
SEMANTICS_SEND_SAMPLES=false
# 语义检索默认返回条数
SEMANTICS_SEARCH_DEFAULT_LIMIT=20
# ---- M3 关系发现与验证预算（可选，均有代码默认值）----
# 单次召回最多保留的候选关系数（超出按分数截断）
RELATIONSHIP_MAX_CANDIDATES_PER_RUN=200
# 每个引用方列最多保留的 Top-K 目标（防同名泛配对）
RELATIONSHIP_TOPK_PER_FIELD=5
# 单次召回处理期限（秒，只读本地元数据）
RELATIONSHIP_DISCOVERY_DEADLINE_SECONDS=60
# 单次验证最多处理的候选数
RELATIONSHIP_VALIDATION_MAX_CANDIDATES=10
# 单次验证总查询数预算（所有候选共享，不嵌套放大）
RELATIONSHIP_VALIDATION_MAX_QUERIES=120
# 单条聚合查询期限提示（毫秒；MySQL>=5.7.8 服务端 SELECT 期限，MariaDB 回退客户端超时）
RELATIONSHIP_QUERY_TIMEOUT_MS=15000
# 单次验证运行总期限（秒）
RELATIONSHIP_VALIDATION_DEADLINE_SECONDS=300
# 证据采样窗口行数（窗口未截断才记 exact 口径）
RELATIONSHIP_SAMPLE_WINDOW_ROWS=500
# 成本门槛：右端行数估计超此值且连接列无索引时拒绝 JOIN 探测（降级 unknown）
RELATIONSHIP_EXACT_MAX_ROWS=50000
# 并发验证上限（当前实现串行执行=1；配置保留用于未来并行化）
RELATIONSHIP_MAX_CONCURRENT_VALIDATIONS=1
# 自动 validated 的前向覆盖率阈值（exact 口径；仅高覆盖率不能单独升级）
RELATIONSHIP_COVERAGE_THRESHOLD=0.995
# 路径搜索预算：最大跳数/路径数/搜索节点数/期限
RELATIONSHIP_PATH_MAX_HOPS=3
RELATIONSHIP_PATH_MAX_PATHS=5
RELATIONSHIP_PATH_MAX_NODES=200
RELATIONSHIP_PATH_DEADLINE_SECONDS=10

# ---- M4 语义模型（可选，均有代码默认值）----
# 主题路径搜索最大跳数
SEMANTIC_MODEL_MAX_HOPS=2
# 同对实体保留的候选路径数（超过标记歧义待审）
SEMANTIC_MODEL_MAX_PATHS_PER_PAIR=3
# 单次构建最多生成的主题数
SEMANTIC_MODEL_MAX_TOPICS=50
# 构建期限（秒，确定性规则，纯本地）
SEMANTIC_MODEL_BUILD_DEADLINE_SECONDS=60
